# Postgres connection string. Local: docker compose (see README). Production: Neon.
DATABASE_URL=postgres://aura:aura@localhost:5432/aura

# Production only: sign-up is closed unless this is "true". Set it while creating your account, then remove it.
# ALLOW_SIGNUP=true

# Dev only: freeze "now" to test time-based rules (missed tasks, end-of-day). ISO 8601.
# Ignored when NODE_ENV=production.
# AURA_NOW=2026-10-26T15:00:00-03:00

# Routine reminders (Web Push). Generate keys with: npx web-push generate-vapid-keys
# Needed in production for reminders; without them the reminder sheet says they are not configured.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://github.com/<you>/aura
# Secret the scheduler sends to /api/cron/reminders as "Authorization: Bearer <value>". Without it the route is closed.
# CRON_SECRET=
